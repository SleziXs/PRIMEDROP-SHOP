    <script>
        // Telegram WebApp Initialization
        let tg = window.Telegram?.WebApp;
        if (tg) {
            tg.expand();
            tg.enableClosingConfirmation();
        }

        // TARGET ADMIN USERNAME FOR ORDER SUBMISSION
        const ADMIN_USERNAME = "BSleziB"; 

        // SAMPLE PRODUCTS DATA
        const products = [
            {
                id: 1,
                name: "Nike Dunk Low 'Panda'",
                category: "cipok",
                price: 49900,
                oldPrice: 59900,
                image: "https://images.unsplash.com/photo-1595950653106-6c9ebd614d3a?w=600&q=80",
                sizes: ["40", "41", "42", "42.5", "43", "44"],
                stock: 3,
                views: 28
            },
            {
                id: 2,
                name: "Trapstar Irongate Puffer Jacket",
                category: "puloverek",
                price: 89900,
                oldPrice: 109900,
                image: "https://images.unsplash.com/photo-1544441893-675973e31985?w=600&q=80",
                sizes: ["S", "M", "L", "XL"],
                stock: 2,
                views: 42
            },
            {
                id: 3,
                name: "Sp5der Worldwide Hoodie Black",
                category: "puloverek",
                price: 64900,
                oldPrice: 74900,
                image: "https://images.unsplash.com/photo-1556905055-8f358a7a47b2?w=600&q=80",
                sizes: ["M", "L", "XL"],
                stock: 1,
                views: 19
            },
            {
                id: 4,
                name: "Supreme Canvas Shoulder Bag",
                category: "kiegeszitok",
                price: 29900,
                oldPrice: 34900,
                image: "https://images.unsplash.com/photo-1553062407-98eeb64c6a62?w=600&q=80",
                sizes: ["ONE SIZE"],
                stock: 4,
                views: 11
            }
        ];

        let cart = [];
        let selectedProduct = null;
        let selectedSize = null;

        // RENDER PRODUCTS
        function renderProducts(items) {
            const grid = document.getElementById('product-grid');
            grid.innerHTML = '';

            items.forEach(product => {
                const card = document.createElement('div');
                card.className = 'glass-card rounded-2xl overflow-hidden flex flex-col justify-between cursor-pointer group border border-white/5 hover:border-gold/30 transition-all';
                card.onclick = () => openProductModal(product.id);

                card.innerHTML = `
                    <div>
                        <div class="relative aspect-square overflow-hidden bg-black/40">
                            <img src="${product.image}" alt="${product.name}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                            <span class="absolute top-2 left-2 bg-red-500/90 text-white text-[9px] font-black px-2 py-0.5 rounded-md backdrop-blur-md">
                                🔥 Csak ${product.stock} db
                            </span>
                        </div>
                        <div class="p-3">
                            <h3 class="font-bold text-xs text-white line-clamp-1">${product.name}</h3>
                            <div class="flex items-baseline gap-1.5 mt-1">
                                <span class="font-black text-sm text-gold">${product.price.toLocaleString('hu-HU')} Ft</span>
                                <span class="text-[10px] text-gray-500 line-through">${product.oldPrice.toLocaleString('hu-HU')} Ft</span>
                            </div>
                        </div>
                    </div>
                    <div class="px-3 pb-3">
                        <button class="w-full bg-white/5 border border-white/10 hover:border-gold text-gray-200 text-[11px] font-bold py-2 rounded-xl transition-all flex items-center justify-center gap-1">
                            <i class="fa-solid fa-eye text-gold text-[10px]"></i>
                            <span>Megtekintés</span>
                        </button>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        // FILTER CATEGORY
        function filterCategory(cat) {
            document.querySelectorAll('.cat-btn').forEach(btn => {
                btn.classList.remove('bg-gold', 'text-black', 'font-bold');
                btn.classList.add('bg-dark-card', 'text-gray-300', 'border', 'border-white/10');
            });
            event.target.classList.add('bg-gold', 'text-black', 'font-bold');
            event.target.classList.remove('bg-dark-card', 'border-white/10');

            if (cat === 'all') {
                renderProducts(products);
            } else {
                renderProducts(products.filter(p => p.category === cat));
            }
        }

        // OPEN PRODUCT MODAL
        function openProductModal(id) {
            selectedProduct = products.find(p => p.id === id);
            selectedSize = selectedProduct.sizes[0]; // Default size

            document.getElementById('modal-img').src = selectedProduct.image;
            document.getElementById('modal-title').innerText = selectedProduct.name;
            document.getElementById('modal-cat').innerText = `Kategória: ${selectedProduct.category.toUpperCase()}`;
            document.getElementById('modal-price').innerText = `${selectedProduct.productPrice ? selectedProduct.productPrice.toLocaleString('hu-HU') : selectedProduct.price.toLocaleString('hu-HU')} Ft`;
            document.getElementById('modal-old-price').innerText = `${selectedProduct.oldPrice.toLocaleString('hu-HU')} Ft`;
            document.getElementById('modal-stock-tag').innerText = `🔥 Csak ${selectedProduct.stock} db maradt ezen az áron!`;

            // Render sizes
            const sizeContainer = document.getElementById('modal-sizes');
            sizeContainer.innerHTML = '';
            selectedProduct.sizes.forEach(size => {
                const sizeBtn = document.createElement('button');
                sizeBtn.type = 'button';
                sizeBtn.className = `px-3.5 py-2 rounded-xl text-xs font-bold transition-all border ${size === selectedSize ? 'bg-gold text-black border-gold shadow-md shadow-gold/20' : 'bg-black/40 text-gray-300 border-white/10'}`;
                sizeBtn.innerText = size;
                sizeBtn.onclick = (e) => {
                    e.stopPropagation();
                    selectedSize = size;
                    document.querySelectorAll('#modal-sizes button').forEach(b => {
                        b.className = 'px-3.5 py-2 rounded-xl text-xs font-bold transition-all border bg-black/40 text-gray-300 border-white/10';
                    });
                    sizeBtn.className = 'px-3.5 py-2 rounded-xl text-xs font-bold transition-all border bg-gold text-black border-gold shadow-md shadow-gold/20';
                };
                sizeContainer.appendChild(sizeBtn);
            });

            document.getElementById('product-modal').classList.remove('hidden');
        }

        function closeProductModal() {
            document.getElementById('product-modal').classList.add('hidden');
        }

        // CART LOGIC
        function addToCartFromModal() {
            if (!selectedProduct) return;

            const existingIndex = cart.findIndex(item => item.id === selectedProduct.id && item.size === selectedSize);
            if (existingIndex > -1) {
                cart[existingIndex].qty += 1;
            } else {
                cart.push({
                    id: selectedProduct.id,
                    name: selectedProduct.name,
                    price: selectedProduct.price,
                    size: selectedSize,
                    image: selectedProduct.image,
                    qty: 1
                });
            }

            closeProductModal();
            updateCartUI();

            // Vibrate feedback if TG API available
            if (tg && tg.HapticFeedback) {
                tg.HapticFeedback.notificationOccurred('success');
            }
        }

        function updateCartUI() {
            const cartBar = document.getElementById('cart-bar');
            const cartBadge = document.getElementById('cart-count-badge');
            const cartTotal = document.getElementById('cart-total-price');

            const totalItems = cart.reduce((sum, item) => sum + item.qty, 0);
            const totalPrice = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);

            if (totalItems > 0) {
                cartBar.classList.remove('hidden');
                cartBadge.innerText = totalItems;
                cartTotal.innerText = `${totalPrice.toLocaleString('hu-HU')} Ft`;
            } else {
                cartBar.classList.add('hidden');
            }
        }

        // CHECKOUT MODAL LOGIC
        function openCheckoutModal() {
            const itemsList = document.getElementById('checkout-items-list');
            itemsList.innerHTML = '';

            let totalPrice = 0;

            cart.forEach((item, idx) => {
                totalPrice += item.price * item.qty;
                const row = document.createElement('div');
                row.className = 'flex items-center justify-between py-2 border-b border-white/5 last:border-none';
                row.innerHTML = `
                    <div class="flex items-center gap-2.5">
                        <img src="${item.image}" class="w-10 h-10 rounded-lg object-cover">
                        <div>
                            <div class="font-bold text-xs text-white">${item.name}</div>
                            <div class="text-[10px] text-gold">Méret: ${item.size} | ${item.qty}x</div>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="font-extrabold text-xs text-white">${(item.price * item.qty).toLocaleString('hu-HU')} Ft</span>
                        <button onclick="removeItemFromCart(${idx})" class="text-gray-500 hover:text-red-400 text-xs px-1">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </div>
                `;
                itemsList.appendChild(row);
            });

            // Auto-fill Telegram user data if available
            if (tg && tg.initDataUnsafe && tg.initDataUnsafe.user) {
                const user = tg.initDataUnsafe.user;
                if (user.first_name) {
                    document.getElementById('cust-name').value = `${user.first_name} ${user.last_name || ''}`.trim();
                }
            }

            document.getElementById('checkout-modal').classList.remove('hidden');
        }

        function closeCheckoutModal() {
            document.getElementById('checkout-modal').classList.add('hidden');
        }

        function removeItemFromCart(index) {
            cart.splice(index, 1);
            updateCartUI();
            if (cart.length === 0) {
                closeCheckoutModal();
            } else {
                openCheckoutModal();
            }
        }

        // SUBMIT ORDER TO TELEGRAM
        function submitOrder(e) {
            e.preventDefault();

            const name = document.getElementById('cust-name').value.trim();
            const phone = document.getElementById('cust-phone').value.trim();
            const city = document.getElementById('cust-city').value.trim();
            const address = document.getElementById('cust-address').value.trim();
            const note = document.getElementById('cust-note').value.trim();

            let total = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);

            // Construct formatted message
            let message = `🛒 *ÚJ PRIMEDROP RENDELÉS*\n\n`;
            message += `👤 *Vevő:* ${name}\n`;
            message += `📞 *Tel:* ${phone}\n`;
            message += `📍 *Cím:* ${city}, ${address}\n`;
            if (note) message += `📝 *Megjegyzés:* ${note}\n`;
            message += `\n────────────────\n📦 *RENDELT TERMÉKEK:*\n`;

            cart.forEach((item, i) => {
                message += `${i+1}. *${item.name}*\n   • Méret: ${item.size}\n   • Mennyiség: ${item.qty} db\n   • Ár: ${(item.price * item.qty).toLocaleString('hu-HU')} Ft\n`;
            });

            message += `────────────────\n💳 *ÖSSZESEN:* ${total.toLocaleString('hu-HU')} Ft\n`;
            message += `🚚 *Szállítás:* INGYENES\n\n`;
            message += `✨ _Kérlek igazold vissza a rendelésemet és küldd el az utalási adatokat!_`;

            // Open Direct Chat with Admin on Telegram
            const encodedText = encodeURIComponent(message);
            const telegramUrl = `https://t.me/${ADMIN_USERNAME}?text=${encodedText}`;

            if (tg) {
                tg.openTelegramLink(telegramUrl);
                tg.close();
            } else {
                window.location.href = telegramUrl;
            }
        }

        // COUNTDOWN TIMER
        function startCountdown() {
            let seconds = 892; // ~14 mins
            const timerEl = document.getElementById('countdown');
            setInterval(() => {
                seconds--;
                if (seconds < 0) seconds = 900;
                const m = Math.floor(seconds / 60).toString().padStart(2, '0');
                const s = (seconds % 60).toString().padStart(2, '0');
                timerEl.innerText = `00:${m}:${s}`;
            }, 1000);
        }

        // LIVE VIEWS SIMULATOR
        function startLiveViews() {
            const viewsEl = document.getElementById('live-views');
            setInterval(() => {
                const current = parseInt(viewsEl.innerText);
                const change = Math.floor(Math.random() * 5) - 2;
                let newViews = current + change;
                if (newViews < 11) newViews = 12;
                if (newViews > 35) newViews = 29;
                viewsEl.innerText = newViews;
            }, 4000);
        }

        // INITIALIZE
        window.onload = function() {
            renderProducts(products);
            startCountdown();
            startLiveViews();
        };
    </script>
